// New product schema requires its forward migration before this release is deployed.
// Keep hosted booking/membership disabled until the disposable-branch rehearsal passes.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}
enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  platformAdmin Boolean @default(false)
  emailVerificationRequired Boolean @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  credentialVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships BusinessMember[]
  sentInvitations BusinessInvitation[] @relation("InvitationInviter")
  acceptedInvitations BusinessInvitation[] @relation("InvitationAccepter")
  sessions RefreshSession[]
  securityTokens AccountSecurityToken[]
  auditLogs AuditLog[]
}
model Business {
  id String @id @default(cuid())
  name String
  slug String @unique
  country String
  currency String
  timezone String
  bookingLeadMinutes Int @default(60)
  cancellationNoticeMinutes Int @default(60)
  rescheduleNoticeMinutes Int @default(60)
  bookingHorizonDays Int @default(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  members BusinessMember[]
  invitations BusinessInvitation[]
  staff Staff[]
  services Service[]
  customers Customer[]
  appointments Appointment[]
  bookingRequests BookingRequest[]
  bookingMutations BookingMutation[]
  notificationJobs NotificationJob[]
  payments SandboxPayment[]
  subscription SandboxSubscription?
  categories ServiceCategory[]
  auditLogs AuditLog[]
}
model BusinessMember {
  id String @id @default(cuid())
  businessId String
  userId String
  role MemberRole @default(MEMBER)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([businessId, userId])
  @@index([userId])
}
model BusinessInvitation {
  id String @id @default(cuid())
  businessId String
  invitedEmail String
  role MemberRole
  tokenDigest String @unique
  invitedById String
  acceptedById String?
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  declinedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  @@index([businessId, expiresAt])
  @@index([businessId, invitedEmail, expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
}
model Staff {
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  id String @id @default(cuid())
  businessId String
  name String
  active Boolean @default(true)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services StaffService[]
  availability AvailabilityRule[]
  exceptions ScheduleException[]
  appointments Appointment[]
  @@unique([businessId, id])
}
model Service {
  kind String @default("SERVICE")
  categoryId String?
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  category ServiceCategory? @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  components ServiceComponent[] @relation("Package")
  usedBy ServiceComponent[] @relation("Component")
  id String @id @default(cuid())
  businessId String
  name String
  durationMinutes Int
  price Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff StaffService[]
  appointments Appointment[]
  @@unique([businessId, id])
}
model StaffService {
  businessId String
  staffId String
  serviceId String
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)
  @@id([businessId, staffId, serviceId])
  @@index([businessId, serviceId])
}
model Customer {
  appointmentEmailOptIn Boolean @default(false)
  id String @id @default(cuid())
  businessId String
  name String
  email String?
  phone String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  @@unique([businessId, id])
  @@index([businessId, email])
}
model AvailabilityRule {
  id String @id @default(cuid())
  businessId String
  staffId String
  // Local wall-clock minutes in the business IANA timezone; 0 = Sunday.
  weekday Int
  startMinute Int
  endMinute Int
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  @@index([businessId, staffId, weekday])
}
model ScheduleException {
  id String @id @default(cuid())
  businessId String
  staffId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  unavailable Boolean @default(true)
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  @@index([businessId, staffId, startsAt])
}
model Appointment {
  id String @id @default(cuid())
  businessId String
  staffId String
  serviceId String
  customerId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(CONFIRMED)
  // Snapshot pricing prevents later service edits changing historical totals.
  price Decimal @db.Decimal(12,2)
  currency String
  serviceNameSnapshot String?
  catalogSnapshot Json @default("[]")
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  occupiedStartsAt DateTime @default(dbgenerated()) @db.Timestamptz(3)
  occupiedEndsAt DateTime @default(dbgenerated()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  bookingRequests BookingRequest[]
  bookingMutations BookingMutation[]
  notificationJobs NotificationJob[]
  payments SandboxPayment[]
  @@unique([businessId, id])
  @@index([businessId, startsAt])
}
model BookingRequest {
  id String @id @default(cuid())
  businessId String
  idempotencyKey String
  payloadHash String
  appointmentId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
}
model RefreshSession {
  // Revocation record for Auth.js encrypted JWT, not a browser-exposed refresh token.
  id String @id @default(cuid())
  userId String
  credentialVersion Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model AccountSecurityToken {
  id String @id @default(cuid())
  userId String
  purpose AccountTokenPurpose
  digest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}
model AuditLog {
  id String @id @default(cuid())
  businessId String
  actorId String?
  action String
  entityId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([businessId, createdAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model ServiceCategory {
  id String @id @default(cuid())
  businessId String
  name String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]
  @@unique([businessId, id])
  @@unique([businessId, name])
}
model ServiceComponent {
  businessId String
  packageId String
  componentId String
  quantity Int @default(1)
  package Service @relation("Package", fields: [businessId, packageId], references: [businessId, id], onDelete: Cascade)
  component Service @relation("Component", fields: [businessId, componentId], references: [businessId, id], onDelete: Restrict)
  @@id([businessId, packageId, componentId])
  @@index([businessId, componentId])
}
model BookingMutation {
  id String @id @default(cuid())
  businessId String
  appointmentId String
  operationKey String
  payloadHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  @@unique([businessId, operationKey])
  @@index([businessId, appointmentId])
}

model NotificationJob {
  id String @id @default(cuid())
  businessId String
  appointmentId String
  kind String
  revision String
  dedupKey String @unique
  state String @default("PENDING")
  scheduledFor DateTime @db.Timestamptz(3)
  attempts Int @default(0)
  firstAttemptAt DateTime? @db.Timestamptz(3)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(3)
  providerReference String?
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  @@index([state, scheduledFor])
  @@index([leaseUntil])
  @@index([businessId, createdAt])
}
model SandboxPayment {
  id String @id @default(cuid())
  businessId String
  appointmentId String?
  operationKey String
  payloadHash String
  providerReference String? @unique
  providerIntent String? @unique
  currency String
  amountMinor Int
  paidMinor Int @default(0)
  refundedMinor Int @default(0)
  state String @default("PENDING")
  mode String @default("TEST")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  events SandboxPaymentEvent[]
  refunds SandboxRefund[]
  @@unique([businessId, id])
  @@unique([businessId, operationKey])
  @@index([businessId, appointmentId])
}
model SandboxPaymentEvent {
  id String @id @default(cuid())
  businessId String
  paymentId String
  providerEventId String @unique
  payloadHash String
  eventType String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  payment SandboxPayment @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
}
model SandboxRefund {
  id String @id @default(cuid())
  businessId String
  paymentId String
  operationKey String
  amountMinor Int
  state String @default("PENDING")
  providerReference String? @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  payment SandboxPayment @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
  @@unique([businessId, operationKey])
  @@index([businessId, paymentId])
}
model SandboxSubscription {
  id String @id @default(cuid())
  businessId String @unique
  plan String @default("FREE")
  state String @default("FREE")
  mode String @default("TEST")
  trialUsed Boolean @default(false)
  trialEndsAt DateTime? @db.Timestamptz(3)
  periodEndsAt DateTime? @db.Timestamptz(3)
  graceEndsAt DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean @default(false)
  providerReference String? @unique
  lastProviderCreated Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  events SandboxSubscriptionEvent[]
  @@unique([businessId, id])
}
model SandboxSubscriptionEvent {
  id String @id @default(cuid())
  businessId String
  subscriptionId String
  providerEventId String @unique
  payloadHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  subscription SandboxSubscription @relation(fields: [businessId, subscriptionId], references: [businessId, id], onDelete: Restrict)
}
